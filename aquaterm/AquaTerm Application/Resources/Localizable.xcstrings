    "Show bounds" : {
      "comment" : "Show bounds",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show Bounds"
          }
        }
      }
    },
    "The client is finished with the plot (or exiting) and tries to close the window. Do you want to close the window or keep it on screen?" : {
      "comment" : "Client closing. Keep window open?",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le client a terminé le tracé (ou sort) et essaie de fermer la fenêtre. Voulez-vous fermer la fenêtre ou la garder à l'écran ?"
          }
        }
      }
    },
    "There are still clients connected to AquaTerm and quitting now may disrupt them.\nYou can leave AquaTerm running by pressing Cancel or confirm quitting by pressing Quit." : {
      "comment" : "Idle client are still running."
    },
    "There are still clients connected to AquaTerm awaiting events and quitting now may leave them in an infinite loop.\nYou can leave AquaTerm running by pressing Cancel or confirm quitting by pressing Quit." : {
      "comment" : "Client are awaiting input.",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Il y a encore des clients connectés à AquaTerm en attente d'événements et quitter maintenant peut les laisser dans une boucle infinie. Vous pouvez laisser AquaTerm en cours d'exécution en appuyant sur Annuler ou confirmer la quitte en appuyant sur Quitter."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "イベントを待っているAquaTermに接続されたクライアントがまだ存在し、今終了すると、無限のループに残される可能性があります。キャンセルを押してAquaTermを実行したままにするか、終了を押して終了を確認することができます。"
          }
        }
      }
    }
  },
  "version" : "1.0"
