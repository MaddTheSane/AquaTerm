framework module AquaTerm {
	module AquaTerm [extern_c] {
		header "aquaterm.h"
		export *
	}
	
	module AQTAdapter {
		requires objc
		header "AQTAdapter.h"
		export *
	}
	
	module AQTModel {
		requires objc
		header "AQTModel.h"
		export *
	}
	
	module AQTGraphic {
		requires objc
		header "AQTGraphic.h"
		
		module AQTColorMap {
			header "AQTColorMap.h"
			export *
		}
		
		module AQTLabel {
			header "AQTLabel.h"
			export *
		}
		
		module AQTImage {
			header "AQTImage.h"
			export *
		}
		
		module AQTPath {
			header "AQTPath.h"
			export *
		}
		
		module AQTPicture {
			header "AQTPicture.h"
			export *
		}
		export *
	}
	
	module AQTFunctions {
		requires objc
		header "AQTFunctions.h"
		export *
	}
	
	explicit module AQTClientManager {
		requires objc
		header "AQTClientManager.h"
		export *
	}
	
	explicit module AQTPlotBuilder {
		requires objc
		header "AQTPlotBuilder.h"
		export *
	}
	
	explicit module Protocols {
		requires objc
		
		module Client {
			header "AQTClientProtocol.h"
			export *
		}
		
		module Event {
			header "AQTEventProtocol.h"
			export *
		}
		
		module Connection {
			header "AQTConnectionProtocol.h"
			export *
		}
		export *
	}
	
	export *
}
